# Copy this file to .env and fill in the paths for your machine.
# Find them with:
#   brew --prefix espeak-ng      -> use <prefix>/lib/libespeak-ng.dylib
#   which espeak-ng              -> use for both PATH vars below
PHONEMIZER_ESPEAK_LIBRARY=/opt/homebrew/opt/espeak-ng/lib/libespeak-ng.dylib
PHONEMIZER_ESPEAK_PATH=/opt/homebrew/bin/espeak-ng
ESPEAK_PATH=/opt/homebrew/bin/espeak-ng
